
strategy
  single_method
  tabular_graphics_data

model
  single

interface
  fork asynchronous evaluation_concurrency = 9 file_tag, file_save
  analysis_driver = 'ips_dakota_client.py'
  parameters_file = 'params.in'
  results_file    = 'results.out'
  failure_capture = recover -1.0 -1.0

responses
  num_objective_functions = 2
  no_gradients
  no_hessians

