  TE_ALPHA = 1.50         ! core general parabolic inner exponent
  TE_BETA = 1.05          ! core general parabolic outer exponent
  TE_XMID =  0.962          ! pedestal mid point
  TE_XWID = 0.076          ! pedestal width
  TE_FIT = 1              ! 1 = smotth

  TI_AXIS = 28.0          ! ion temperature [keV]
