  A_MIN = 1               ! mass number of minority ions; array of N_MIN; integer; neglected if N_MIN = 0
  N_BEAM = 1              ! number of beam ions
  Z_BEAM = 1              ! charge number of beam ions; array of N_BEAM; integer ; D
  A_BEAM = 2              ! mass number of beam ions; array of N_BEAM; integer ; D
  N_FUSION = 1            ! number of fusion particles
  Z_FUSION = 2            ! charge number of fusion particles; array of N_FUSION; integer ; alpha particle
  A_FUSION = 4            ! charge number of fusion particles; array of N_FUSION; integer ; alpha particle

  NRHO = 101 

  NE_AXIS = 17.8          ! density [10^19 m^-3]
