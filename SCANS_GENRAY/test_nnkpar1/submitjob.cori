#!/bin/bash -l
#SBATCH -p debug
#SBATCH -N 1
#SBATCH -t 00:30:00
#SBATCH -C haswell
#SBATCH -J ips_fastran
#SBATCH -e ips.err
#SBATCH -o ips.out

module load python
module load gcc
source activate /global/common/software/atom/cori/cesol_conda/v0.1

ips.py --config=fastran_scenario.config --platform=cori_haswell.conf --log=ips.log 

conda deactivate
