# ======================================================================
# PORTS SECTION
# ======================================================================

[PORTS]

    NAMES = INIT DRIVER EQ0 TR0 BC0 EQ LH TR BC
    PREPROCESS = EQ0 TR0 BC0 

    # Required ports - DRIVER and INIT   
    [[DRIVER]]
        IMPLEMENTATION = fastran_driver
    [[INIT]]
        IMPLEMENTATION = fastran_init
      
    # Physics ports
    [[TR0]]
        IMPLEMENTATION = fastran0
    [[TR]]
        IMPLEMENTATION = fastran
    [[EQ0]]
        IMPLEMENTATION = efit0
    [[EQ]]
        IMPLEMENTATION = efit
    [[EC]]				# ECH
        IMPLEMENTATION = toray
    [[HC]]				# Helicon
        IMPLEMENTATION = genray_hc
    [[LH]]				# LHC
        IMPLEMENTATION = genray_lh
    [[CQL3D]]
        IMPLEMENTATION = cql3d
    [[IC]]				# HCD
        IMPLEMENTATION = hcd_model
    [[RF]]				# ICRF-FW
        IMPLEMENTATION = toric
    [[NB]]				# NBeam
	IMPLEMENTATION = nfreya
#       IMPLEMENTATION = nubeam  
    [[BC0]]
        IMPLEMENTATION = constraint_current0
    [[BC]]
        IMPLEMENTATION = constraint_current
    [[FEEDBACK]]
        IMPLEMENTATION = constraint_feedback
    [[POST]]
        IMPLEMENTATION = fastran1

    # Gyrokinetics Ports
    [[GENE]]
 	IMPLEMENTATION = gene

    # Stability Ports
    [[DCON]]
	IMPLEMENTATION = dcon
    [[DCONIW]]
	IMPLEMENTATION = dconiw
    [[DCONNW]]
	IMPLEMENTATION = dconnw

    [[DCONIW0p2]]
	IMPLEMENTATION = dconiw0p2
    [[DCONIW0p4]]
	IMPLEMENTATION = dconiw0p4
    [[DCONIW0p6]]
	IMPLEMENTATION = dconiw0p6
    [[DCONIW0p8]]
	IMPLEMENTATION = dconiw0p8
    [[DCONIW1p0]]
	IMPLEMENTATION = dconiw1p0
    [[DCONIW1p2]]
	IMPLEMENTATION = dconiw1p2
    [[DCONIW1p4]]
	IMPLEMENTATION = dconiw1p4
    [[DCONIW1p6]]
	IMPLEMENTATION = dconiw1p6
    [[DCONIW1p8]]
	IMPLEMENTATION = dconiw1p8
    [[DCONIW2p0]]
	IMPLEMENTATION = dconiw2p0
    [[DCONIW2p2]]
	IMPLEMENTATION = dconiw2p2
    [[DCONIW2p4]]
	IMPLEMENTATION = dconiw2p4
    [[DCONIW2p6]]
	IMPLEMENTATION = dconiw2p6
    [[DCONIW2p8]]
	IMPLEMENTATION = dconiw2p8
    [[DCONIW3p0]]
	IMPLEMENTATION = dconiw3p0

    # Monitor ports
    [[MONITOR]]
        IMPLEMENTATION = monitor

