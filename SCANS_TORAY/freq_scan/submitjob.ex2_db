#!/bin/bash -l
#SBATCH -q regular
#SBATCH -N 3
#SBATCH -t 07:10:00
#SBATCH -J ips_fastran
#SBATCH -e ips.err
#SBATCH -o ips.out
#SBATCH -C cpu

module load python
source activate /global/common/software/atom/perlmutter/cesol/conda/dev

export SHOT_NUMBER=000001
export TIME_ID=00001
export FASTRAN_BIN_NAME=xfastran_ver1.06

ips_dakota_dynamic.py --dakotaconfig=dakota.in --simulation=fastran_scenario.config --platform=$MACHINE_CONFIG --log=ips_sweep.log

conda deactivate
